local KillerHighlightConnection
local KillerHighlights = {}

local function adicionarKillerHighlight(obj)
    if not obj:IsA("Model") then
        return
    end

    -- O Humanoid precisa estar diretamente dentro deste Model
    local humanoid = obj:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if obj:FindFirstChild("HumanoidHighlight") then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "HumanoidHighlight"
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = obj

    table.insert(KillerHighlights, highlight)
end

local function limparKillerHighlights()
    for _, highlight in ipairs(KillerHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end

    table.clear(KillerHighlights)
end

local Toggle = VTab:Toggle({
