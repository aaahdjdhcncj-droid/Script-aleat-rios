    Default = false,

    Callback = function(state)
        if KillerHighlightConnection then
            KillerHighlightConnection:Disconnect()
            KillerHighlightConnection = nil
        end

        limparKillerHighlights()

        if not state then
            return
        end

        local Floor = workspace:FindFirstChild("Floor")
        if not Floor then
